#!/bin/sh
# /etc/s6/rc.local — Runink River init-context launcher.
#
# Executed by the s6 `rc-local` oneshot at the end of boot, in INIT context (PID-1 tree),
# not in a login session, so elogind never reaps what it starts.
#
# What is deliberately NOT here: a Kubernetes node, a CI runner, tunnels, off-box backups. A
# downstream distribution that needs them ships its own rc.local in its own profile
# (docs/BUILD.md, "Downstream distributions").
#
# The desktop itself is NOT started here. greetd is an s6 service declared in profile.yaml's
# live-session.services and enabled at install by 80-enable-s6.sh — starting a display
# manager from rc.local would race the one s6 already supervises. The host firewall
# (runink-fw), the ZFS datasets (zfs-mount) and the shadow-grade modes (river-perms) are s6
# oneshots too, and have already run.
set -eu

log() { echo "rc.local: $*"; }

# 0. Boot splash fallback ----------------------------------------------------
# The plymouth-quit oneshot (a dependency of greetd) normally ends the splash. If greetd
# is disabled or failed, nothing would, and the splash would sit over the text console.
# This runs BEFORE the live guard below: a live medium whose desktop fails needs the splash
# gone just as much as an installed machine does — more, because the console underneath is
# the only way left to install. (It used to sit after the guard's `exit 0`, so on the live
# medium a failed SDDM left the splash over the console: a blank screen and no way in.)
/usr/local/bin/runink-plymouth-quit

# 0a. GPU seat watcher -------------------------------------------------------
# WHY. On a slow boot SDDM starts, asks elogind whether seat0 can do graphics, is told "no",
# and waits for ever. Measured 2026-10-19 booting this ISO from an emulated USB stick at
# 15 MB/s, with the real machine's symptom ("waiting for the desktop (30s of 6m0s)") on screen:
#
#   sddm.log        "Logind interface found" ... and then NOTHING, until river-live-fallback
#                   SIGTERMed it six minutes later. No display, no greeter, no session.
#   loginctl        seat0: CanGraphical=no
#   /sys/class/drm  card1 + renderD128 present since ~30s, driver bound
#   udevadm info    card1 had 6 E: lines and NO TAGS — no `seat`, no `master-of-seat` — so
#                   elogind never counted it as graphics
#
# One `udevadm trigger --action=add --subsystem-match=drm` + settle changed that to 13 E:
# lines, TAGS=:seat:uaccess:master-of-seat:, and CanGraphical=yes. The coldplug oneshot
# (`udevadm`) had run, and still the GPU ended up unclassified: elogind depends only on dbus,
# so it comes up alongside coldplug, and the DRM card registers whenever its driver finishes
# loading — much later when the firmware has to be read off a slow stick.
#
# WHAT. A background watcher: once a DRM card exists and seat0 is still not graphical, ask
# udev to re-classify the DRM devices (at most five times). If the seat turned graphical that
# way and no compositor has appeared 15s later, restart the display manager once — it may already have
# given up on the seat. It never blocks boot, does nothing on a machine that comes up
# graphical on its own, and records what it did in /run/river-gpu-seat.log.
#
# It is NOT a fix for a machine with no usable GPU driver: if the only card is the EFI
# framebuffer (simpledrm) there is no render node and kwin cannot start; the live medium's
# fallback (river-live-fallback) takes over after its timeout, as before.
gpu_seat_watch() {
	set +e +u
	log_f=/run/river-gpu-seat.log
	command -v loginctl >/dev/null 2>&1 || { echo "no loginctl: nothing to watch" >"$log_f"; return 0; }
	can() { loginctl show-seat seat0 -p CanGraphical 2>/dev/null | sed -n 's/^CanGraphical=//p'; }
	native_card() { # a DRM card bound to a real driver, not the EFI framebuffer's simpledrm
		for c in /sys/class/drm/card[0-9]*; do
			case "$c" in *-*) continue ;; esac
			[ -e "$c/device/driver" ] || continue
			d=$(basename "$(readlink -f "$c/device/driver")")
			case "$d" in simple-framebuffer | simpledrm) ;; *) return 0 ;; esac
		done
		return 1
	}
	any_card() { for c in /sys/class/drm/card[0-9]*; do case "$c" in *-*) continue ;; esac; [ -e "$c" ] && return 0; done; return 1; }
	n=0 tries=0 last=-10
	: >"$log_f"
	while [ "$n" -lt 150 ]; do
		[ "$(can)" = yes ] && break
		# A native driver is the signal; with only simpledrm, wait a minute before acting.
		if { native_card || { [ "$n" -ge 30 ] && any_card; }; } && [ "$tries" -lt 5 ] && [ $((n - last)) -ge 5 ]; then
			echo "t=$((n * 2))s seat0 CanGraphical=$(can) with a DRM card present: re-triggering udev for drm (try $((tries + 1)))" >>"$log_f"
			udevadm trigger --action=add --subsystem-match=drm
			udevadm settle -t 20
			tries=$((tries + 1)) last=$n
			sleep 1
			[ "$(can)" = yes ] && break
		fi
		sleep 2
		n=$((n + 1))
	done
	echo "t=$((n * 2))s seat0 CanGraphical=$(can) after $tries re-trigger(s)" >>"$log_f"
	[ "$tries" -gt 0 ] && [ "$(can)" = yes ] || return 0
	sleep 15
	# The display manager's longrun (sddm's pipeline, or greetd's plain longrun), and the
	# compositors its greeter or session can be.
	dm=""
	for d in sddm-srv greetd; do [ -d "/run/service/$d" ] && { dm=$d; break; }; done
	[ -n "$dm" ] || return 0
	for c in kwin_wayland Xorg cage desk weston; do
		pgrep -x "$c" >/dev/null 2>&1 && { echo "a compositor ($c) is up: $dm did not need a restart" >>"$log_f"; return 0; }
	done
	echo "no compositor 15s after the seat turned graphical: restarting $dm" >>"$log_f"
	s6-svc -r "/run/service/$dm"
}
( gpu_seat_watch ) >/dev/null 2>&1 &

# 0b. Live-installer guard ---------------------------------------------------
# Booted from the ISO the kernel cmdline carries `overlay=livefs`: that is the INSTALLER
# environment, not an installed machine. Without this guard the live session does tuning work
# on a rootfs that is about to be discarded.
if grep -qw 'overlay=livefs' /proc/cmdline 2>/dev/null; then
	log "live installer session — host tuning skipped (run the installer to provision)"
	# A live medium must ALWAYS reach an installer. river-live-fallback waits for the
	# desktop and, if none appears, starts the console kiosk and then the text installer
	# on tty1 — as root, from here, so nobody has to find a terminal or type a
	# privileged command. It does nothing when the desktop comes up normally.
	# Backgrounded: it waits by design and must never hold up the boot.
	if [ -x /usr/local/bin/river-live-fallback ]; then
		/usr/local/bin/river-live-fallback &
	fi
	exit 0
fi

# 1. OS tuning ---------------------------------------------------------------
sysctl --system >/dev/null 2>&1 || log "sysctl --system reported issues (non-fatal)"

# zram, zstd: sized by the install plan (/etc/runink/zram.conf), else 1:1 with RAM (the live
# medium, or a machine installed without a plan). Pair this with /etc/sysctl.d/99-runink-workstation.conf
# (swappiness=150, page-cluster=0) — the device without that tuning leaves most of the
# benefit on the table, and the tuning without the device is actively harmful on a
# disk-backed swap.
RUNINK_ZRAM_DEFAULT=ram /usr/local/bin/runink-zram.sh || log "zram setup failed (non-fatal)"

# 2. First-boot hooks ----------------------------------------------------------
# /usr/local/lib/runink/firstboot.d/* (a downstream's setup hand-off, docs/PAYLOADS.md): runs
# each hook until it has succeeded once. No hooks (Runink River itself) = no-op. Backgrounded:
# it must never hold up the boot.
/usr/local/bin/river-firstboot-hooks &

# 2b. Graphical first boot -----------------------------------------------------
# Only when the installer left the marker (an edition with firstboot_ui; Runink River's has
# none) and the image carries the kiosk. No marker = no-op. Backgrounded.
if [ -e /var/lib/runink/firstboot-ui ]; then /usr/local/bin/river-firstboot-ui & fi

log "host tuning complete"
