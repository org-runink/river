#!/bin/sh
# SPDX-FileCopyrightText: 2026 The RIVER Authors
# SPDX-License-Identifier: MIT
#
# river-kiosk — show the graphical installer on a machine whose desktop did not start.
#
# IT IS A COMPOSITOR AND A BROWSER. Nothing else. That is the whole design, and it is the
# design every other live medium uses: CachyOS, Manjaro and Fedora all boot a session and run
# their installer as an ordinary window in it. Nobody draws their installer onto bare KMS.
#
# This script used to. It ran WPE WebKit's MiniBrowser with WPE_DISPLAY=wpe-display-drm --
# straight to the display through KMS, no compositor at all -- as a dedicated unprivileged
# user, with its own content-filter rules, its own VT bookkeeping and its own pointer
# workarounds. It was clever and it did not work: on the owner's XPS 13 9300 it aborted five
# times in ten seconds with "Failed to connect to display of type wpe-display-drm: No suitable
# DRM device found", and the install fell through to the text installer on a laptop where three
# other distributions open their wizard without trouble.
#
# WPE's DRM backend wants a device with a hardware cursor plane and a GPU renderer. A plain EFI
# framebuffer (simpledrm) has neither, and simpledrm is exactly what you get before -- or
# instead of -- a real driver binding. So the bespoke path failed precisely on the machines
# that needed a fallback at all.
#
# A compositor solves this because solving it is its job. wlroots drives KMS properly, and
# falls back to software rendering (WLR_RENDERER=pixman) when there is no GPU to render with.
# So: cage, which is a Wayland compositor that runs exactly one fullscreen application, and
# inside it the SAME river-installer-desktop the Plasma session already runs. One browser, one
# launcher, one definition of what the installer looks like, used by both paths.
#
# What this deletes, and does not miss: the river-kiosk user and its group juggling, the
# WebKit content-filter JSON, WPE_DISPLAY/WPE_DRM_DISABLE_ATOMIC, the manual "is the operator
# on another VT" polling and the pause/resume of the view around it. A compositor on a seat
# does the VT handover itself, through libseat and elogind, which is the thing it is for.
set -u

VT="" URL_WAIT=120
while [ $# -gt 0 ]; do
	case "$1" in
		--vt) VT=${2:?}; shift 2 ;;
		--wait) URL_WAIT=${2:?}; shift 2 ;;
		*) echo "river-kiosk: unknown argument: $1" >&2; exit 2 ;;
	esac
done

RUN=/run/river-kiosk
LAUNCH=/usr/local/bin/river-installer-desktop
U=${RIVER_KIOSK_USER:-runink}
log() { echo "river-kiosk: $*"; }
mkdir -p "$RUN"; rm -f "$RUN/kiosk.stop"

command -v cage >/dev/null 2>&1 || { log "cage is not installed: no compositor, no graphical fallback"; exit 1; }
[ -x "$LAUNCH" ] || { log "$LAUNCH is missing: nothing to show"; exit 1; }
id "$U" >/dev/null 2>&1 || { log "no user $U to run the session as"; exit 1; }

# WAIT FOR A DISPLAY BEFORE DRAWING ON ONE. Ready means a card node exists AND some connector
# is not `disconnected` -- deliberately not `= connected`, because a connector reports
# connected, disconnected or UNKNOWN, and "unknown" is what virtual and some embedded drivers
# report for a perfectly usable panel. Requiring `connected` would wait the full timeout on
# exactly the machines where this already works.
DRMWAIT=${RIVER_KIOSK_DRMWAIT:-60}
drm_ready() {
	ls /dev/dri/card* >/dev/null 2>&1 || return 1
	for st in /sys/class/drm/card*-*/status; do
		[ -r "$st" ] || continue
		[ "$(cat "$st" 2>/dev/null)" = disconnected ] || return 0
	done
	return 1
}
if drm_ready; then
	log "display: a usable output is already present"
else
	log "display: waiting up to ${DRMWAIT}s for one (the GPU driver may still be probing)"
	i=0
	while [ "$i" -lt "$DRMWAIT" ]; do drm_ready && break; sleep 1; i=$((i + 1)); done
	drm_ready && log "display: appeared after ${i}s" \
		|| log "display: none after ${DRMWAIT}s (cards: $(ls /dev/dri 2>/dev/null | tr '\n' ' ')) — trying anyway"
fi

river-installer wait --url "http://[::1]:47660/api/state" --timeout "${URL_WAIT}s" \
	|| log "the installer is not answering yet; starting anyway"
[ -n "$VT" ] && river-installer vt "$VT"

# A session that will not stay up must give up, not spin: river-live-fallback only moves on to
# the text installer when this EXITS, and a view restarting once a second overwrites the very
# console that installer is drawing on. Backoff 2/4/8/16s so the attempts span ~30s rather than
# a blink -- shorter than that and a slow GPU probe loses a race it only had to wait out.
MINRUN=${RIVER_KIOSK_MINRUN:-10}
MAXFAIL=${RIVER_KIOSK_MAXFAIL:-4}
fails=0

# Attempts 1..2 use whatever renderer wlroots picks (GL where there is a GPU). From attempt 3 we
# force the software renderer: that is the simpledrm / no-GPU case, and pixman draws there when
# GL cannot. Trying GL first keeps a normal machine fast.
run_once() {
	renderer=""
	[ "$fails" -ge 2 ] && renderer="WLR_RENDERER=pixman"
	[ -n "$renderer" ] && log "attempt $((fails + 1)): forcing the software renderer ($renderer)" \
		|| log "attempt $((fails + 1)): starting the compositor"
	started=$(date +%s)
	# shellcheck disable=SC2086 # renderer is one KEY=VALUE word or empty, by construction
	setpriv --reuid="$U" --regid="$U" --init-groups \
		env -i HOME="/home/$U" USER="$U" PATH=/usr/local/bin:/usr/bin:/bin \
		XDG_RUNTIME_DIR="/run/user/$(id -u "$U")" LANG=C.UTF-8 \
		XDG_SESSION_TYPE=wayland $renderer \
		cage -- "$LAUNCH" >"$RUN/session.log" 2>&1
	rc=$?
	ran=$(( $(date +%s) - started ))
	return $rc
}

while :; do
	[ -e "$RUN/kiosk.stop" ] && { log "stopped"; exit 0; }
	run_once || true
	if [ "${ran:-0}" -ge "$MINRUN" ]; then
		# It ran long enough to have been used. An ordinary exit after real use is the
		# operator closing the installer, not a broken machine.
		log "the session ended after ${ran}s"
		exit 0
	fi
	fails=$((fails + 1))
	if [ "$fails" -ge "$MAXFAIL" ]; then
		log "the session died $fails times in under ${MINRUN}s each: it cannot run on this"
		log "  machine. Giving up so the text installer can have the console."
		# PRINT THE REASON. A failure that cannot be read is a failure that cannot be fixed,
		# and this machine has no serial port, no network and no desktop to read it from.
		if [ -s "$RUN/session.log" ]; then
			log "  what the compositor said (last 15 lines of $RUN/session.log):"
			tail -15 "$RUN/session.log" | sed -e 's/^/    | /'
		else
			log "  $RUN/session.log is empty: it died before writing anything."
		fi
		exit 1
	fi
	back=$(( 1 << fails )); [ "$back" -gt 16 ] && back=16
	log "the session exited after ${ran}s (failure $fails of $MAXFAIL); retrying in ${back}s"
	sleep "$back"
done
