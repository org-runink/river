#!/bin/sh
# shellcheck disable=SC2086  # $TABLE is the two-token nft id "inet runink_fw"; must word-split
# runink-fw — the host firewall (nftables table `inet runink_fw`), both families.
#
# One posture, loaded on every Runink River machine from the first boot and on the live
# medium (runink-firewall-base.nft): default-deny input except loopback, established, ICMPv6
# + ICMPv4 essentials, DHCP client replies, mDNS and the ports opened on purpose (SSH is
# closed until /etc/runink/fw-open says "tcp 22");
# default-DROP forward except the interfaces listed in /etc/runink/fw-forward
# (runink-fw-common.nft). Outbound is open.
#
#   runink-fw apply                   load the ruleset + seed its sets (s6 oneshot runink-fw at
#                                     boot, before NetworkManager and sshd)
#   runink-fw open  <tcp|udp> <port>  open a port to everyone until the next apply (persist
#                                     it in /etc/runink/fw-open, e.g. "tcp 22" for SSH)
#   runink-fw close <tcp|udp> <port>  close it again
#   runink-fw list                    show the ruleset, the sets and the counters
#   runink-fw flush                   remove the table: NO firewall until the next apply
#
# Files: /etc/runink/fw-open (lines "tcp 8080" / "udp 51820"), /etc/runink/fw-forward (one
# interface name per line: a container bridge or VM network the machine may route for), and
# on the LIVE medium only /usr/local/lib/river-pair/fw-pair (the LAN-install pairing ports,
# link-local sources only). '#' comments allowed.
set -eu

LIB="/usr/local/lib/runink-net"
BASE="$LIB/runink-firewall-base.nft"
OPEN="/etc/runink/fw-open"
FORWARD="/etc/runink/fw-forward"
PAIR="/usr/local/lib/river-pair/fw-pair"
TABLE="inet runink_fw"

log() { echo "runink-fw: $*"; }
have_nft() { command -v nft >/dev/null 2>&1; }

lines() { # lines FILE — its entries, comments and blanks stripped
	[ -f "$1" ] || return 0
	sed 's/#.*//' "$1" | grep -vE '^[[:space:]]*$' || true
}

seed_open() {
	lines "$OPEN" | while read -r proto port _rest; do
		case "$proto:$port" in
			tcp:[0-9]*|udp:[0-9]*) nft add element $TABLE "open_$proto" "{ $port }" 2>/dev/null \
				|| log "open: could not add $proto $port" ;;
			*) log "open: ignoring '$proto $port' (want: tcp|udp PORT)" ;;
		esac
	done
}

seed_forward() {
	lines "$FORWARD" | while read -r ifc _rest; do
		case "$ifc" in
			*[!A-Za-z0-9_.-]*) log "forward: ignoring '$ifc' (want an interface name)" ;;
			*) nft add element $TABLE forward_if "{ \"$ifc\" }" 2>/dev/null \
				|| log "forward: could not add $ifc" ;;
		esac
	done
}

# is_live — this system runs from the live installer medium (the same mount points
# river-pair-announce's isLive checks: artix/archiso/miso live, dracut live).
is_live() {
	awk '$2 ~ /^\/run\/(artix|archiso|miso)\// || $2 == "/bootmnt" || $2 == "/run/initramfs/live" || $2 == "/run/rootfsbase" { f = 1 } END { exit !f }' /proc/mounts 2>/dev/null
}

# seed_pair — the LIVE medium's LAN-install pairing ports (udp 47653 announcement, tcp 47654
# pairing, tcp 47655 restricted sshd) into pair_tcp / pair_udp, which the common rules accept
# from IPv6 link-local sources only. Two guards, so an installed machine never opens them: the
# list lives in the live overlay under /usr/local/lib/river-pair (never cloned to a target),
# and it is honoured only when this runs from the live medium.
seed_pair() {
	[ -f "$PAIR" ] || return 0
	if ! is_live; then
		log "pair: $PAIR present but this is not the live medium: pairing ports stay closed"
		return 0
	fi
	lines "$PAIR" | while read -r proto port _rest; do
		case "$proto:$port" in
			tcp:[0-9]*|udp:[0-9]*) nft add element $TABLE "pair_$proto" "{ $port }" 2>/dev/null \
				|| log "pair: could not add $proto $port" ;;
			*) log "pair: ignoring '$proto $port' (want: tcp|udp PORT)" ;;
		esac
	done
	log "pair: live medium: LAN-install pairing ports open to IPv6 link-local sources ($(lines "$PAIR" | awk '{ printf "%s%s/%s", (NR > 1 ? " " : ""), $1, $2 }'))"
}

cmd_apply() {
	have_nft || { log "nft not installed — NO host firewall"; exit 0; }
	[ -f "$BASE" ] || { log "ruleset $BASE missing"; exit 1; }
	nft -f "$BASE"
	seed_open
	seed_forward
	seed_pair
	log "firewall applied: default-deny input (ICMP, DHCP, mDNS, open ports), forward default-drop"
}

cmd_port() { # open|close PROTO PORT
	op="$1"; proto="${2:-}"; port="${3:-}"
	case "$proto" in tcp|udp) ;; *) echo "usage: runink-fw $op <tcp|udp> <port>" >&2; exit 2 ;; esac
	case "$port" in ''|*[!0-9]*) echo "usage: runink-fw $op <tcp|udp> <port>" >&2; exit 2 ;; esac
	have_nft || { log "nft not installed"; exit 1; }
	if [ "$op" = open ]; then
		nft add element $TABLE "open_$proto" "{ $port }"
		log "opened $proto/$port to everyone (until the next apply; persist it in $OPEN)"
	else
		if nft delete element $TABLE "open_$proto" "{ $port }" 2>/dev/null; then log "closed $proto/$port"
		else log "$proto/$port was not open"; fi
	fi
}

cmd_list() {
	have_nft || { log "nft not installed"; exit 1; }
	nft list table $TABLE 2>/dev/null || echo "(no runink_fw table loaded: NO host firewall)"
}

cmd_flush() { nft delete table $TABLE 2>/dev/null || true; log "runink_fw table removed: NO host firewall until 'runink-fw apply'"; }

case "${1:-apply}" in
	apply) cmd_apply ;;
	open|close) cmd_port "$@" ;;
	list)  cmd_list ;;
	flush) cmd_flush ;;
	*) echo "usage: runink-fw {apply|open|close <tcp|udp> <port>|list|flush}" >&2; exit 2 ;;
esac
