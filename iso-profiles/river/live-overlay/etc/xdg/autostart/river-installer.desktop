# Runink River live medium: when the live DEsk session starts, the graphical installer opens once,
# as a normal window beside the desktop (river-installer-desktop --window: Firefox on the
# installer's loopback address, after a local "starting" page). Close it to keep trying the live
# system; "Install Runink River" in the drawer and on the desktop opens it again. Live overlay
# only: 20-clone-rootfs excludes this file, so an installed machine does not open it.
[Desktop Entry]
Type=Application
Name=Install Runink River
Comment=Install Runink River on this computer
Exec=/usr/local/bin/river-installer-desktop --window
Icon=runink-river
Terminal=false
NoDisplay=true
OnlyShowIn=DEsk;
