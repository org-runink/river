pipewire-jack

# ── bluetooth ────────────────────────────────────────────────────────────────────────
# No Bluetooth applet: blueman, the one DEsk's Shell Settings opens, is Python. bluetoothctl
# (bluez-utils) pairs devices. The s6 service (bluez-s6) is with the other -s6 packages above.
bluez
bluez-utils

# ── printing ─────────────────────────────────────────────────────────────────────────
# No printer program: system-config-printer is Python, so printers are set up on CUPS's own
