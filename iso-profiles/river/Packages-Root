gst-plugins-base
gst-plugins-good
gst-plugins-bad
gst-plugins-ugly
gst-libav
ffmpeg
intel-media-driver
libva-utils

# ── audio ──────────────────────────────────────────────────────────────────────────────
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
