# pacman.conf.in — the build-time pacman configuration of the Arch-based image
# (docs/ARCH-BASE.md). Rendered by the image builder: @LOCALREPO@ -> the absolute path of the
# local [runink] repository built from build/pkgbuilds and base/.
#
# Official Arch Linux [core] and [extra], pinned to ONE dated snapshot of the Arch Linux
# Archive (ARCH_PIN_DATE and ARCH_ARCHIVE in pacman/mirrorlist.pin), plus our own [runink].
# No Artix repository, no [multilib], no [*-testing]. The Artix configuration that the shipping
# ISO still uses is pacman/artix/pacman.conf.in, until the Arch-based ISO boots (step D4).
#
# ORDER IS LOAD-BEARING. pacman installs a name from the FIRST repository that has it.
# [runink] comes first because it carries our rebuilds of Arch packages under their Arch names
# (the hard systemd dependents, docs/ARCH-BASE.md §4): they must win over [core]/[extra].

[options]
Architecture = x86_64
CheckSpace
# Arch signs every package but not the repository databases, and the archive serves no .db.sig:
# packages are required to be signed, databases are verified only if a signature exists.
SigLevel = Required DatabaseOptional
LocalFileSigLevel = Optional
ParallelDownloads = 5
# systemd is forbidden in the image's closure (docs/ARCH-BASE.md §4); river lint closure
# enforces it against the profile's forbidden.closure. Nothing here relies on that alone.

# --- Our built packages (first, see ORDER above) ---
[runink]
SigLevel = Optional TrustAll
Server = file://@LOCALREPO@

# --- Arch Linux, pinned to the archive snapshot in pacman/mirrorlist.pin ---
# The builder writes ARCH_ARCHIVE into /etc/pacman.d/mirrorlist-arch (builder/arch.Containerfile).
[core]
Include = /etc/pacman.d/mirrorlist-arch

[extra]
Include = /etc/pacman.d/mirrorlist-arch

# --- ZFS: NOT a separate repo ---
# runink-zfs and runink-zfs-utils come from [runink], built from the same signed OpenZFS tarball.

# ==== [blackarch] goes here, LAST (owned by the BlackArch change, docs/ARCH-BASE.md §5.1) ====
# Last on purpose: a name in both [core]/[extra] and [blackarch] must resolve to Arch's.
