#!/bin/execlineb -P
# SPDX-FileCopyrightText: 2026 The RIVER Authors
# SPDX-License-Identifier: MIT
# Runink River base cloud image (docs/cloud/gcp.md). Before the network: machine-id, SSH host
# keys and, on a ZFS root, the hostid, all cleared from the image before capture. A failure is
# logged and does not stop the boot.
/bin/sh -c "/usr/local/bin/river-cloud-init identity || echo 'river-cloud-identity: failed (see /var/log/river-cloud-init.log)' >&2; exit 0"
