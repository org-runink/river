# build/config.env — pinned upstream versions for the from-source components.
# Sourced by build/*.sh. Update deliberately; every bump is a golden-image change.

# k0s Kubernetes — the workload substrate (baked by build/pkgbuilds/runink-k0s).
# FLOOR v1.33: first line whose kube-router auto-selects the nft backend
# (iptables-wrapper), matching kube-proxy — see runink-k0s/PKGBUILD header.
#
# Enforced by river lint k0s-pin (wired into `make lint` AND `make iso`): this value,
# the PKGBUILD and the package in localrepo/ are checked against each other, because
# buildiso bakes whatever package sits in localrepo/, not this line.
# Bumping this value alone does NOT change what ships; update the PKGBUILD (_k0sver, pkgver,
# sha256sums) too, then rebuild: make components && make localrepo.
K0S_VERSION="v1.31.2+k0s.0"

# Output staging.
OUT_DIR="$(cd "$(dirname "${0:-.}")" >/dev/null 2>&1 && pwd)/artifacts"

# ── Downstream payload (optional) ─────────────────────────────────────────────────────
# RIVER builds a complete, bootable base image on its own. A downstream platform that
# wants to ship ON RIVER supplies a payload directory (outside this repository) and points
# RIVER_PAYLOAD_DIR at it. build-all.sh then runs "$RIVER_PAYLOAD_DIR/build.sh "$OUT_DIR"",
# which must stage:
#   $OUT_DIR/bin/*          host binaries        -> packaged by runink-runtime
#   $OUT_DIR/core-tree/     the platform tree    -> packaged by runink-core, installed at
#                                                   /usr/local/share/runink/core
#     core-tree/deploy      (executable) run by first-boot enrollment on a controller
#     core-tree/enroll.d/*.sh  (optional) sourced by first-boot enrollment with the
#                              enrollment variables in scope, before the file is shredded
# See docs/BUILD.md, "Downstream payloads". Unset = base image (no payload).
RIVER_PAYLOAD_DIR="${RIVER_PAYLOAD_DIR:-}"
