# Maintainer: The RIVER Authors (see MAINTAINERS.md)
# s6-frontend — skarnet.org user interface to s6: the s6 command (s6 set, s6 live, s6 repository)
#
# Built from skarnet.org's release tarball, pinned by sha256 below. skarnet publishes a .sha256
# beside each tarball and no OpenPGP signature; the pin was checked against that file
# (2026-11-28), which is a transcription check from the same origin, not independent provenance.
# This replaces the distribution's binary package: the s6 stack in [runink] is built here, from
# upstream source, and nothing in it comes from another distribution.
#
# Static skarnet libraries only (skalibs --disable-shared, every package's --enable-allstatic
# default): the programs link libc dynamically and nothing else, so the stack carries no shared
# library of its own and no ABI coupling between its packages on upgrade.
#
# The service stores are /etc/s6/adminsv (the base services, runink-s6-base) and /etc/s6/sv
# (one directory per daemon, from the *-s6 packages and the image's overlay). Paths match
# s6-rc's build (above) and /etc/s6.conf.
pkgname=s6-frontend
pkgver=0.2.0.0
pkgrel=1
pkgdesc="skarnet.org user interface to s6: the s6 command (s6 set, s6 live, s6 repository)"
arch=('x86_64')
url="https://skarnet.org/software/s6-frontend/"
license=('ISC')
options=('staticlibs')
depends=('glibc' 'execline' 's6' 's6-rc' 's6-linux-init')
makedepends=('skalibs' 'execline' 's6' 's6-rc' 's6-linux-init')
source=("https://skarnet.org/software/s6-frontend/s6-frontend-${pkgver}.tar.gz")
sha256sums=('4bce4e9bec8c1de9e3ee5ef764580421504a3c6303eff96997b69d1b89219536')

build() {
	cd "s6-frontend-${pkgver}"
	./configure \
		--prefix=/usr \
		--libdir=/usr/lib \
		--libexecdir=/usr/lib/s6-frontend \
		--with-sysdeps=/usr/lib/skalibs/sysdeps \
		--scandir=/run/service \
		--livedir=/run/s6-rc \
		--repodir=/etc/s6/repo \
		--bootdb=/etc/s6/rc/compiled \
		--conffile=/etc/s6.conf \
		--userconffile=/etc/s6-user.conf \
		--with-store-list=/etc/s6/adminsv:/etc/s6/sv \
		--with-default-bundle=default
	make
}

package() {
	cd "s6-frontend-${pkgver}"
	make DESTDIR="$pkgdir" install
	install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
