Configure, build and install dbus without python3.

Upstream's meson build calls python3 for the test suite, the Doxygen docs, a probe of
TMPDIR/TEMP/TMP for the default socket directory, and a post-install script that sets the
launch helper's owner and mode. This build compiles none of the tests or docs, fixes the
socket directory at /tmp (what the probe answers in a package build), and sets the launch
helper's owner and mode in the PKGBUILD's package().

--- a/meson.build
+++ b/meson.build
@@ -84,7 +84,8 @@
 ###############################################################################
 # System detection
 
-python = find_program('python3')
+# No Python in this build. python3 served the test suite and the Doxygen docs (neither is
+# built here) and the socket-directory probe (replaced below).
 
 host_os = host_machine.system()
 
@@ -1073,12 +1074,9 @@
 data_config.set('DATADIR_FROM_PKGSYSCONFDIR', datadir_from_pkgsysconfdir)
 
 #### Find socket directories
-values = run_command(python, '-c',
-    'import os; [print(os.getenv(e, "")) for e in ["TMPDIR", "TEMP", "TMP"]]',
-    check: true,
-).stdout()
-values += '/tmp'
-default_socket_dir = values.strip().split('\n')[0]
+# The upstream probe read TMPDIR/TEMP/TMP with python3; a package build has none set,
+# so it always answered /tmp.
+default_socket_dir = '/tmp'
 
 test_socket_dir = get_option('test_socket_dir')
 if test_socket_dir == ''
@@ -1263,13 +1261,11 @@
 if tools
     subdir('tools')
 endif
-subdir('test')
 subdir('doc')
 subdir('cmake')
 
-meson.add_install_script('meson_post_install.py',
-    '@0@'.format(relocation),
-)
+# meson_post_install.py (python3) is not run: it only set the launch helper's owner and
+# mode, which the package does itself, and relocated the .pc file (relocation=disabled).
 
 pkgconfig.generate(
     libdbus,
