Arch/Artix filesystem layout for dbus (adapted from Arch's 0001-Arch-Linux-tweaks.patch,
which Artix's dbus package also applies):

- do not install the legacy /etc/dbus-1 config
- do not package the runstatedir (/run/dbus is created at runtime)
- use the preassigned message bus UID 81

--- a/bus/meson.build
+++ b/bus/meson.build
@@ -84,7 +84,6 @@
     endif
 endif
 
-subdir('legacy-config')
 
 
 libdbus_daemon_internal_sources = [
@@ -190,7 +189,6 @@
 
 if platform_unix
     install_emptydirs += [
-        runstatedir / 'dbus',
         get_option('datadir') / 'dbus-1' / 'system.d',
         get_option('datadir') / 'dbus-1' / 'system-services',
     ]
--- a/bus/sysusers.d/dbus.conf.in
+++ b/bus/sysusers.d/dbus.conf.in
@@ -2,4 +2,4 @@
 # at boot on systemd-based systems that ship with an unpopulated
 # /etc. See sysusers.d(5) for details.
 
-u @DBUS_USER@ - "System Message Bus"
+u @DBUS_USER@ 81 "System Message Bus"
