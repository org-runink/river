new file mode 100644
index 0000000..a2e1726
--- /dev/null
+++ b/tools/checkwords/checkwords_test.go
@@ -0,0 +1,67 @@
+package checkwords
+
+import (
+	"strings"
+	"testing"
+)
+
+// TestWordTables is what `meson test` ran: the tables in this tree are right.
+func TestWordTables(t *testing.T) {
+	bad, missing, err := Tree("../..")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, b := range bad {
+		t.Error(b)
+	}
+	t.Logf("%d printed keys with no row (shown in English)", len(missing))
+	for _, k := range missing {
+		t.Logf("  %q", k)
+	}
+}
+
+const fixture = `/* words */
+static const char *const WORDS[][DESK_LANG_COUNT] = {
+	{ "Open", "開く", NULL, NULL, "Abrir", "Ouvrir", "Öffnen" },
+	{ "%d letters", "%d 通", NULL, NULL, "%d cartas", "%d lettres", "%d Briefe" },
+	{ "verb|Save %s to %s", NULL, NULL, NULL, NULL, "Enregistrer %s dans %s", NULL },
+	{ "100%% done", NULL, NULL, NULL, NULL, NULL, "100\x25% fertig" },
+};
+`
+
+// TestCheckCatchesEachFault is the mutation proof: a right table passes, and
+// each fault the check exists for, put into it, is reported.
+func TestCheckCatchesEachFault(t *testing.T) {
+	check := func(src string) []string {
+		t.Helper()
+		rows, err := Table("fixture.c", src)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(rows) != 4 {
+			t.Fatalf("read %d rows, want 4", len(rows))
+		}
+		bad, _ := Check("fixture.c", rows)
+		return bad
+	}
+	if bad := check(fixture); len(bad) != 0 {
+		t.Fatalf("a right table is reported wrong: %v", bad)
+	}
+	for _, c := range []struct{ name, from, to, says string }{
+		{"a column short", `"Öffnen" }`, `}`, "6 columns, not 7"},
+		{"a key twice", `"%d letters"`, `"Open"`, "is in the table already"},
+		{"a conversion changed", `"%d Briefe"`, `"%s Briefe"`, "de takes [%s], the English [%d]"},
+		{"conversions reordered", `"Enregistrer %s dans %s"`, `"Enregistrer %d dans %s"`, "fr takes"},
+		{"a %% lost", `"100\x25% fertig"`, `"100 fertig"`, "de takes"},
+		{"a control character", `"Abrir"`, `"Ab\trir"`, "es has a control character"},
+		{"no English", `{ "Open",`, `{ NULL,`, "no English"},
+	} {
+		if !strings.Contains(fixture, c.from) {
+			t.Fatalf("%s: the fixture has no %q", c.name, c.from)
+		}
+		bad := check(strings.Replace(fixture, c.from, c.to, 1))
+		if !strings.Contains(strings.Join(bad, "\n"), c.says) {
+			t.Errorf("%s: not reported (want %q), got %v", c.name, c.says, bad)
+		}
+	}
+}
