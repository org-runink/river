+/* What the room looks like, as numbers, for the cache of traced rooms.
+ *
+ *     room-key out.h room.glsl gpu.c
+ *
+ * A traced room is kept on disk from one login to the next, and is traced
+ * again only when it would come out different. Every change to the scene has
+ * to reach the shader -- room.glsl is the C tracer's double, and checked
+ * against it -- so a hash of the shader stands for the room; a change on the
+ * C side alone (a camera, the resolve, the sidecar) bumps ROOM_LOOK in
+ * draw.c. Whether this machine's GPU traces it right is asked again when
+ * gpu.c changes as well. Built and run by the build itself (native: true). */
+
+#include <stdint.h>
+#include <stdio.h>
+
+/* 32-bit FNV-1a over the file, starting from h */
+static int fnv(const char *path, uint32_t *h)
+{
+	FILE *f = fopen(path, "rb");
+	if (!f) {
+		perror(path);
+		return -1;
+	}
+	int c;
+	while ((c = fgetc(f)) != EOF) {
+		*h = (*h ^ (uint32_t)c) * 16777619u;
+	}
+	int bad = ferror(f);
+	fclose(f);
+	return bad ? -1 : 0;
+}
+
+int main(int argc, char **argv)
+{
+	if (argc != 4) {
+		fprintf(stderr, "usage: room-key out.h room.glsl gpu.c\n");
+		return 2;
+	}
+	uint32_t room = 2166136261u;
+	if (fnv(argv[2], &room) < 0) {
+		return 1;
+	}
+	uint32_t both = room;
+	if (fnv(argv[3], &both) < 0) {
+		return 1;
+	}
+	FILE *out = fopen(argv[1], "w");
+	if (!out) {
+		perror(argv[1]);
+		return 1;
+	}
+	fprintf(out, "/* generated by room-key: a hash of room.glsl, and of gpu.c after it */\n");
+	fprintf(out, "#define DESK_ROOM_GLSL_KEY 0x%08xu\n", (unsigned)room);
+	fprintf(out, "#define DESK_ROOM_GPU_KEY 0x%08xu\n", (unsigned)both);
+	return fclose(out) != 0;
+}
