new file mode 100644
index 0000000..b67cda2
--- /dev/null
+++ b/tools/checkwords/checkwords.go
@@ -0,0 +1,257 @@
+// Package checkwords reads the desk's word tables as C does and says, for each row
+// that is wrong, what is wrong with it.
+//
+// src/i18n.c and src/index.c keep every word the desk prints in a table with a
+// column for each language (include/i18n.h, enum desk_lang): the English, which
+// is the key, then the same in each language, or NULL where there is none yet.
+// A translation that is printed with printf must take what the English takes,
+// in the same order -- %d where %d, %s where %s -- or it reads the wrong thing
+// off the stack. A row is wrong when it has
+//
+//   - not one column for each language
+//   - no English, or a key that is in the table twice
+//   - a translation whose printf conversions are not the English one's
+//   - a translation with a control character in it other than a new line
+//
+// It also lists, as information only, the TR("...") and W("...") keys the
+// sources print that have no row (they are printed in English, which may be
+// meant). This is the Go port of what was scripts/check-words.py.
+package checkwords
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strconv"
+	"strings"
+)
+
+// Langs are the columns, in the order of enum desk_lang.
+var Langs = []string{"en", "ja", "zh", "ko", "es", "fr", "de"}
+
+var (
+	fmtRe   = regexp.MustCompile(`%[-+ #0]*\d*(?:\.\d+)?[hlLqjzt]*[diouxXeEfgGcsp%]`)
+	tokenRe = regexp.MustCompile(`\A(?:"((?:[^"\\]|\\.)*)"|(?s:(/\*.*?\*/))|([{},])|(NULL)|(\s+))`)
+	startRe = regexp.MustCompile(`static const char \*const WORDS\[\]\[DESK_LANG_COUNT\] = \{\n`)
+	usedRe  = regexp.MustCompile(`\b(?:TR|W)\(\s*((?:"(?:[^"\\]|\\.)*"\s*)+)\)`)
+	partRe  = regexp.MustCompile(`"((?:[^"\\]|\\.)*)"`)
+	letter  = regexp.MustCompile(`[A-Za-z]`)
+)
+
+// Row is one row of a table: the line it starts on and its columns (nil: NULL).
+type Row struct {
+	Line int
+	Cols []*string
+}
+
+// unescape turns the body of a C string literal into the string C makes of it.
+func unescape(body string) (string, error) {
+	var out []byte
+	for i := 0; i < len(body); i++ {
+		c := body[i]
+		if c != '\\' {
+			out = append(out, c)
+			continue
+		}
+		if i+1 >= len(body) {
+			return "", fmt.Errorf("a backslash at the end of %q", body)
+		}
+		n := body[i+1]
+		if n == 'x' {
+			j := i + 2
+			for j < len(body) && strings.IndexByte("0123456789abcdefABCDEF", body[j]) >= 0 {
+				j++
+			}
+			v, err := strconv.ParseUint(body[i+2:j], 16, 8)
+			if err != nil {
+				return "", fmt.Errorf("bad \\x escape in %q", body)
+			}
+			out = append(out, byte(v))
+			i = j - 1
+			continue
+		}
+		e, ok := map[byte]byte{'n': '\n', 't': '\t', '"': '"', '\\': '\\', '\'': '\''}[n]
+		if !ok {
+			return "", fmt.Errorf("unknown escape \\%c in %q", n, body)
+		}
+		out = append(out, e)
+		i++
+	}
+	return string(out), nil
+}
+
+// Table returns the rows of the WORDS table in the C source src (named name).
+func Table(name, src string) ([]Row, error) {
+	m := startRe.FindStringIndex(src)
+	if m == nil {
+		return nil, fmt.Errorf("%s: no WORDS table", name)
+	}
+	end := strings.Index(src[m[1]:], "\n};\n")
+	if end < 0 {
+		return nil, fmt.Errorf("%s: the WORDS table does not end", name)
+	}
+	body := src[m[1] : m[1]+end]
+	base := strings.Count(src[:m[1]], "\n") + 1
+	var (
+		rows    []Row
+		cur     []*string
+		inRow   bool
+		lit     *string
+		rowLine int
+	)
+	for pos := 0; pos < len(body); {
+		t := tokenRe.FindStringSubmatchIndex(body[pos:])
+		if t == nil {
+			return nil, fmt.Errorf("%s: cannot read the table near line %d", name,
+				base+strings.Count(body[:pos], "\n"))
+		}
+		grp := func(k int) (string, bool) {
+			if t[2*k] < 0 {
+				return "", false
+			}
+			return body[pos+t[2*k] : pos+t[2*k+1]], true
+		}
+		if s, ok := grp(1); ok {
+			u, err := unescape(s)
+			if err != nil {
+				return nil, fmt.Errorf("%s: %v", name, err)
+			}
+			if lit == nil {
+				lit = new(string)
+			}
+			*lit += u
+		} else if _, ok := grp(4); ok {
+			cur = append(cur, nil)
+		} else if p, ok := grp(3); ok {
+			switch p {
+			case "{":
+				cur, inRow = nil, true
+				rowLine = base + strings.Count(body[:pos], "\n")
+			case ",", "}":
+				if lit != nil {
+					cur = append(cur, lit)
+					lit = nil
+				}
+				if p == "}" && inRow {
+					rows = append(rows, Row{rowLine, cur})
+					cur, inRow = nil, false
+				}
+			}
+		}
+		pos += t[1]
+	}
+	return rows, nil
+}
+
+func conversions(s string) (plain []string, percents int) {
+	for _, f := range fmtRe.FindAllString(s, -1) {
+		if f == "%%" {
+			percents++
+		} else {
+			plain = append(plain, f)
+		}
+	}
+	return plain, percents
+}
+
+// Check checks the rows of one table (name is its file, for the messages) and
+// returns what is wrong, one line each, and the keys it holds.
+func Check(name string, rows []Row) (bad []string, keys map[string]bool) {
+	keys = map[string]bool{}
+	seen := map[string]int{}
+	for _, r := range rows {
+		where := fmt.Sprintf("%s:%d", name, r.Line)
+		if len(r.Cols) != len(Langs) {
+			bad = append(bad, fmt.Sprintf("%s: %d columns, not %d", where, len(r.Cols), len(Langs)))
+			continue
+		}
+		if r.Cols[0] == nil {
+			bad = append(bad, where+": no English")
+			continue
+		}
+		key := *r.Cols[0]
+		if l, ok := seen[key]; ok {
+			bad = append(bad, fmt.Sprintf("%s: %q is in the table already (line %d)", where, key, l))
+		}
+		seen[key] = r.Line
+		keys[key] = true
+		english := key
+		if i := strings.Index(key, "|"); i >= 0 {
+			english = key[i+1:]
+		}
+		want, wantPct := conversions(english)
+		for i, text := range r.Cols[1:] {
+			if text == nil {
+				continue
+			}
+			got, gotPct := conversions(*text)
+			if strings.Join(got, " ") != strings.Join(want, " ") || gotPct != wantPct {
+				bad = append(bad, fmt.Sprintf("%s: %s takes %v, the English %v: %q",
+					where, Langs[i+1], got, want, key))
+			}
+			for _, ch := range *text {
+				if ch < 0x20 && ch != '\n' {
+					bad = append(bad, fmt.Sprintf("%s: %s has a control character in it: %q",
+						where, Langs[i+1], key))
+					break
+				}
+			}
+		}
+	}
+	return bad, keys
+}
+
+// Tree checks src/i18n.c and src/index.c under root. It returns what is wrong,
+// and (information only) the printed keys that have no row.
+func Tree(root string) (bad, missing []string, err error) {
+	keys := map[string]bool{}
+	for _, name := range []string{"src/i18n.c", "src/index.c"} {
+		b, err := os.ReadFile(filepath.Join(root, name))
+		if err != nil {
+			return nil, nil, err
+		}
+		rows, err := Table(name, string(b))
+		if err != nil {
+			return nil, nil, err
+		}
+		if len(rows) == 0 {
+			return nil, nil, fmt.Errorf("%s: the WORDS table has no rows", name)
+		}
+		wrong, k := Check(name, rows)
+		bad = append(bad, wrong...)
+		for key := range k {
+			keys[key] = true
+		}
+	}
+	srcs, err := filepath.Glob(filepath.Join(root, "src", "*.c"))
+	if err != nil {
+		return nil, nil, err
+	}
+	used := map[string]bool{}
+	for _, p := range srcs {
+		b, err := os.ReadFile(p)
+		if err != nil {
+			return nil, nil, err
+		}
+		for _, m := range usedRe.FindAllStringSubmatch(string(b), -1) {
+			var k strings.Builder
+			for _, part := range partRe.FindAllStringSubmatch(m[1], -1) {
+				u, err := unescape(part[1])
+				if err != nil {
+					return nil, nil, fmt.Errorf("%s: %v", p, err)
+				}
+				k.WriteString(u)
+			}
+			used[k.String()] = true
+		}
+	}
+	for k := range used {
+		if !keys[k] && letter.MatchString(k) {
+			missing = append(missing, k)
+		}
+	}
+	sort.Strings(missing)
+	return bad, missing, nil
+}
