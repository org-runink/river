-        x0 = x + i * width
-        cut = slab([(x0, y), (x0 + width, y), (x0 + width - slant, y + h), (x0 - slant, y + h)], x, x + w)
-        if len(cut) >= 3:
-            s += f'<path d="{poly(*cut)}" fill="#1b1b1d"/>'
-    return s
