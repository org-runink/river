+/* Wrap a GLSL file as a C string, so the shader ships inside the binary.
+ *
+ *     glsl2c NAME in.glsl out.h
+ *
+ * Built and run by the build itself (meson.build, native: true), so the build
+ * needs nothing beyond the C compiler it already has. The shader is kept as a
+ * .glsl file rather than as a C string because it is two thousand lines of
+ * code that a person has to read against draw.c, and quotes on every line do
+ * not help with that. */
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+int main(int argc, char **argv)
+{
+	if (argc != 4) {
+		fprintf(stderr, "usage: glsl2c NAME in.glsl out.h\n");
+		return 2;
+	}
+	FILE *in = fopen(argv[2], "rb");
+	if (!in) {
+		perror(argv[2]);
+		return 1;
+	}
+	FILE *out = fopen(argv[3], "wb");
+	if (!out) {
+		perror(argv[3]);
+		return 1;
+	}
+	const char *base = strrchr(argv[2], '/');
+	base = base ? base + 1 : argv[2];
+	fprintf(out, "/* generated from %s by glsl2c -- edit that, not this */\n", base);
+	fprintf(out, "static const char %s[] =\n", argv[1]);
+	int c, open = 0;
+	while ((c = fgetc(in)) != EOF) {
+		if (c > 0x7f) {
+			fprintf(stderr, "%s: not ASCII (byte 0x%02x)\n", argv[2], c);
+			return 1;
+		}
+		if (!open) {
+			fputs("\t\"", out);
+			open = 1;
+		}
+		if (c == '\n') {
+			fputs("\\n\"\n", out);
+			open = 0;
+		} else if (c == '\r') {
+			/* a CRLF line ends at the \n; the \r is not part of it */
+		} else if (c == '\\' || c == '"') {
+			fputc('\\', out);
+			fputc(c, out);
+		} else if (c == '?') {
+			/* -std=c11 still reads trigraphs, and a "??/" in a comment
+			 * would eat the next character */
+			fputs("\\?", out);
+		} else {
+			fputc(c, out);
+		}
+	}
+	if (open) {
+		fputs("\\n\"\n", out);
+	}
+	fputs("\t;\n", out);
+	if (ferror(in) || fclose(out) != 0) {
+		fprintf(stderr, "glsl2c: could not write %s\n", argv[3]);
+		return 1;
+	}
+	fclose(in);
+	return 0;
+}
