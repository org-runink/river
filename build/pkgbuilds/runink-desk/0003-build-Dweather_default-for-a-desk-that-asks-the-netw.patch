+/* shell.conf's `weather` where nobody has set it: on, unless the build said
+ * otherwise (meson -Dweather_default=false), for a machine that is to ask
+ * nothing of the network until its user does */
+#ifndef DESK_WEATHER_DEFAULT
+#define DESK_WEATHER_DEFAULT 1
+#endif
+
 enum {
 	DESK_TITLE_H = 46,
 	DESK_BORDER = 8,
diff --git a/meson.build b/meson.build
index 93399b3..21cf5b5 100644
--- a/meson.build
+++ b/meson.build
@@ -17,6 +17,9 @@ add_project_arguments(
 # and its number, as the notification server tells programs that ask
 add_project_arguments('-DDESK_RELEASE="DEsk v0.1.4 (BETA)"',
   '-DDESK_VERSION="@0@"'.format(meson.project_version()), language: 'c')
+# shell.conf's weather, where nobody has set it (include/desk.h)
+add_project_arguments('-DDESK_WEATHER_DEFAULT=@0@'.format(get_option('weather_default') ? 1 : 0),
+  language: 'c')
 # a variable initialised from itself (x = x) is uninitialised, and in C
 # -Wall does not say so: a keysym once read as garbage that way
