+/* Whether systemd is the init system (what sd_booted() asks). Without it
+ * there is no systemd user manager to tell or untell -- elogind and s6, say
+ * -- and asking one only fails, every login. */
+static bool systemd_booted(void)
+{
+	return access("/run/systemd/system", F_OK) == 0;
+}
+
 static void unset_activation_environment(void)
 {
 	char prog[1024];
-	if (!on_path("systemctl", prog, sizeof prog)) {
+	if (!systemd_booted() || !on_path("systemctl", prog, sizeof prog)) {
 		return;
 	}
 	char *argv[8];
@@ -217,7 +225,9 @@ static pid_t update_activation_environment(void)
 	char *argv[4 + sizeof ACTIVATION_VARS / sizeof ACTIVATION_VARS[0]];
 	int n = 0;
 	argv[n++] = prog;
-	argv[n++] = "--systemd";
+	if (systemd_booted()) {
+		argv[n++] = "--systemd";
+	}
 	for (size_t i = 0; i < sizeof ACTIVATION_VARS / sizeof ACTIVATION_VARS[0]; i++) {
 		if (getenv(ACTIVATION_VARS[i])) {
 			argv[n++] = (char *)ACTIVATION_VARS[i];
