# Maintainer: The RIVER Authors (see MAINTAINERS.md)
# runink-core — the downstream platform tree, installed at /usr/local/share/runink/core.
#
# RIVER itself ships no platform: this package carries whatever a downstream payload
# (RIVER_PAYLOAD_DIR, see build/config.env) staged in $RUNINK_OUT/core-tree. First-boot
# enrollment runs core-tree/deploy on a controller and sources core-tree/enroll.d/*.sh;
# core-tree/firstboot.d/* are installed to /usr/local/lib/runink/firstboot.d/ and run once
# after k0s is up, with or without enrollment (river-firstboot-hooks).
#
# A BASE image (no payload; build-all.sh exports RIVER_PAYLOAD_NONE=1) gets an empty tree
# plus a PAYLOAD-NONE marker, so enrollment can tell "no platform by design" from "the
# payload build failed and this package shipped hollow". The second case must never
# package: an earlier version checked only that the directory existed, shipped an empty
# tree, and the node came up as a bare substrate while enrollment reported success.
pkgname=runink-core
pkgver=2026.07
pkgrel=1
pkgdesc="RIVER downstream platform tree (payload-supplied; empty on a base image)"
arch=('x86_64')
url="https://github.com/org-runink/river"
license=('MIT')  # the packaging; a payload's own licence travels with the payload
depends=('glibc' 'runink-k0s')
options=('!strip')

package() {
	local out="${RUNINK_OUT:?set RUNINK_OUT to build/artifacts}"
	local tree="$out/core-tree"
	local dest="$pkgdir/usr/local/share/runink/core"
	install -d "$dest"
	if [ "${RIVER_PAYLOAD_NONE:-0}" = 1 ]; then
		printf 'This RIVER image was built without a downstream payload.\n' > "$dest/PAYLOAD-NONE"
		return 0
	fi
	# Verify the PAYLOAD, not the container.
	[ -d "$tree" ] || { echo "runink-core: $tree missing — the payload build staged nothing" >&2; return 1; }
	[ -x "$tree/deploy" ] || { echo "runink-core: $tree/deploy missing or not executable — refusing to package a hollow platform tree" >&2; return 1; }
	# NO CREDENTIALS IN THE IMAGE. The tree is copied WHOLESALE on the next line, so anything a
	# payload leaves in it ships inside the image, readable by anyone who boots it. A payload is
	# built by a downstream, from its own repository, and "nothing secret is in there" is not a
	# property this package can assume on its behalf.
	#
	# It REFUSES rather than excluding. A payload carrying credential material is a broken
	# payload, and silently dropping the files would hide that while leaving them wherever else
	# the payload build put them -- package directories, staged rootfses, worktrees. Same
	# reasoning as the hollow-tree check above: verify the payload, do not paper over it.
	#
	# Matched by NAME: kubeconfigs (they embed client keys by construction), .env (the
	# convention for secrets), and private SSH keys. Matched by CONTENT: a PEM private-key block
	# under any filename, which catches a misnamed key and, deliberately, does NOT catch public
	# certificates -- a payload legitimately carries CA certs.
	local named content
	named="$(find "$tree" -type f \( -name '*.kubeconfig' -o -name 'kubeconfig' -o -name '.env' \
		-o -name 'id_rsa' -o -name 'id_ecdsa' -o -name 'id_ed25519' \) -printf '%P\n' 2>/dev/null | sort)"
	content="$(grep -rlIE -- '-----BEGIN ([A-Z]+ )?PRIVATE KEY-----' "$tree" 2>/dev/null \
		| sed "s|^$tree/||" | sort)"
	if [ -n "$named$content" ]; then
		echo "runink-core: REFUSING to package -- the payload tree carries credential material:" >&2
		[ -n "$named" ] && printf '%s\n' "$named" | sed 's/^/    /' >&2
		[ -n "$content" ] && printf '%s\n' "$content" | sed 's/^/    /' >&2
		echo "  These would ship inside the image, readable by anyone who boots it." >&2
		echo "  Remove them from the payload and rotate anything real. Do not exclude them here:" >&2
		echo "  an exclude would hide a broken payload and leave the files everywhere else." >&2
		return 1
	fi
	cp -a "$tree/." "$dest/"
	chmod 755 "$dest/deploy"
	# Optional first-boot hooks (docs/PAYLOADS.md): core-tree/firstboot.d/* are run by
	# river-firstboot-hooks after the k0s API is up, each until it has succeeded once. Every
	# entry must be an executable regular file; anything else is a broken payload.
	if [ -d "$tree/firstboot.d" ]; then
		local h
		for h in "$tree/firstboot.d"/*; do
			[ -e "$h" ] || continue
			[ -f "$h" ] && [ -x "$h" ] || { echo "runink-core: $h is not an executable file" >&2; return 1; }
			install -Dm755 "$h" "$pkgdir/usr/local/lib/runink/firstboot.d/$(basename "$h")"
		done
	fi
}
