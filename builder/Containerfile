# Reproducible Artix build environment for the RIVER golden image.
#
# `buildiso` (artools) must run on Artix; this dev/CI host is usually not Artix. This
# image gives any podman/docker host the exact toolchain to build the ISO + the from-source
# components:  artools (buildiso), Go, and gcc + base-devel for the [runink] packages
# (tayga; the kernel and OpenZFS build in build/kernel-builder.Containerfile, FROM this image).
# No cmake or ninja: nothing built here uses them. The Flutter SDK (needed only
# by a downstream payload that builds Flutter web bundles) is optional and installed when
# BUILD_FLUTTER=1 to keep the base lean.
#
# Build:   podman build -t runink-os-builder build/../builder   (see `make builder`)
# Use:     podman run --privileged -v $PWD:/os -w /os runink-os-builder make iso
#          (--privileged: buildiso/basestrap need mount + loop devices)
FROM docker.io/artixlinux/artixlinux:latest

ARG BUILD_FLUTTER=0

# Keyring first (fresh Artix containers ship without an initialized keyring), then the
# toolchain. No ZFS userland here: the builder never touches a pool, and the ISO's ZFS
# (runink-zfs + runink-zfs-utils) comes from [runink]. The zfs-utils this list used to name
# exists only in archzfs, which this file only ever added AFTER that install step, so on
# Artix it could only make the whole `pacman -Syu` transaction fail with "target not found".
RUN pacman-key --init && pacman-key --populate artix archlinux 2>/dev/null || true; \
    pacman -Sy --noconfirm --needed \
        artix-keyring archlinux-keyring; \
    pacman -Syu --noconfirm --needed \
        artools-iso artools-pkg \
        base-devel git rsync curl \
        go gcc \
        squashfs-tools dosfstools libarchive \
        wayland wayland-protocols libxkbcommon libinput pixman libdrm mesa libglvnd \
        libdisplay-info seatd libelogind hwdata libxcb xcb-util-renderutil xcb-util-wm \
        xorg-xwayland cairo fontconfig pam libpulse gtk3 json-c greetd \
    ; \
    pacman -Scc --noconfirm

# No Python in the build environment. Nothing this image runs needs it (buildiso, makepkg of
# the [runink] packages, go), but it arrives as a dependency of tools it never runs:
# base-devel's debugedit pulls gdb (which embeds the interpreter) and artools-pkg pulls bzr and
# mercurial (written in it), for VCS package sources this repository does not use. Remove the
# interpreter, every python-* package and the packages that require them, without their
# dependents (-Rdd: debugedit and artools-pkg stay), and fail the image build if an interpreter
# is still on PATH. build/kernel-builder.Containerfile repeats this for images built before it.
RUN py="$(pacman -Qq | grep -E '^python(-|$)' || true)" \
    && if [ -n "$py" ]; then \
         pacman -Rdd --noconfirm $py $(pacman -Qi $py | sed -n 's/^Required By *: //p' \
           | tr ' ' '\n' | grep -vxE 'None|python(-.*)?' | sort -u); \
       fi \
    && ! command -v python3 && ! command -v python \
    && ! ls /usr/bin/python* >/dev/null 2>&1

# muon: the C implementation of meson, for the desktop packages (build/pkgbuilds/runink-
# {wlroots0.18,cage,gtkgreet,desk}), which are meson projects. Meson itself is Python, which the
# step above removes; muon needs only the C compiler, bootstraps itself, and finds libraries with
# pkg-config. A build tool (GPL-3.0) that never ships in an image. The desktop's build
# dependencies are in the first RUN's package list (docs/DESKTOP-DESK-PLAN.md).
ARG MUON_VERSION=0.5.0
ARG MUON_SHA256=24aa4d29ed272893f6e6d355b1ec4ef20647438454e88161bdb9defd7c6faf77
RUN cd /tmp \
    && curl -fsSLo muon.tar.gz "https://muon.build/releases/v${MUON_VERSION}/muon-v${MUON_VERSION}.tar.gz" \
    && echo "${MUON_SHA256}  muon.tar.gz" | sha256sum -c - \
    && mkdir muon-src && tar -xzf muon.tar.gz -C muon-src --strip-components=1 && cd muon-src \
    && ./bootstrap.sh build \
    && build/muon-bootstrap setup -Dprefix=/usr/local -Dbuildtype=release build-final \
    && build/muon-bootstrap -C build-final samu \
    && build/muon-bootstrap -C build-final install \
    && cd / && rm -rf /tmp/muon.tar.gz /tmp/muon-src \
    && muon version

# Optional Flutter SDK (large), for downstream payloads that build Flutter web bundles.
RUN if [ "$BUILD_FLUTTER" = "1" ]; then \
        pacman -Sy --noconfirm --needed unzip clang && \
        git clone --depth 1 -b stable https://github.com/flutter/flutter.git /opt/flutter && \
        /opt/flutter/bin/flutter --version ; \
    fi
ENV PATH="/opt/flutter/bin:${PATH}"

# A non-root build user (makepkg refuses to run as root).
#
# THE UID IS PINNED, and it is half of a pair. build/build-kernel-zfs.sh bind-mounts the
# caller's work directory and runs this user against it, so the two uids must agree or
# makepkg cannot write to its own $BUILDDIR. Without -u this took the first free uid --
# 1000 on Arch, which matches a dev host's first user by luck and does NOT match a
# GitHub-hosted runner, where the user is `runner` at 1001. That is exactly why the public
# image build failed in CI while the same command worked on a workstation:
#
#   ==> ERROR: You do not have write permission for the directory $BUILDDIR
#
# Pinned here, mapped to there (--userns=keep-id:uid=1000,gid=1000), so the pair is stated
# in both files instead of inferred from whoever happens to run the build.
RUN useradd -m -u 1000 -U -G wheel builder && \
    printf 'builder ALL=(ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/builder
USER builder
WORKDIR /os

CMD ["/bin/bash"]
